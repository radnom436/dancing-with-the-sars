# NASA Earthdata Bearer Token (optional: ASF search is public; the token only helps with rate limits/downloads)
# Register at https://urs.earthdata.nasa.gov/ and generate a token
EARTHDATA_TOKEN=your_earthdata_token_here

# Optional
# OPENTOPOGRAPHY_API_KEY=
# SAR_DATA_DIR=/absolute/path/to/your/hdf5/files
# CORS_ORIGINS=https://your-frontend.example      # comma-separated; default is "*"
